# ─────────────────────────────────────────────────────────────
# X Multi Poster 設定ファイル
# このファイルを .env にコピーして編集してください（初期構築時に1回だけ）。
#   cp .env.example .env
# 利用者がアカウントを追加するたびに編集する必要はありません。
# ─────────────────────────────────────────────────────────────

# X Developer Console で作成したアプリの OAuth 2.0 Client ID（必須）
X_CLIENT_ID=

# アプリ種別を「Web App / Automated App or Bot」（Confidential client）にした場合のみ設定。
# 「Native App」（Public client）の場合は空のままで構いません（推奨: Native App）。
X_CLIENT_SECRET=

# X Developer Console の「Callback URI / Redirect URL」に登録した値と完全一致させること
X_CALLBACK_URL=http://127.0.0.1:8787/api/oauth/callback

# バックエンドのポート（変更した場合は X_CALLBACK_URL も合わせて変更）
PORT=8787

# 認可完了画面の「アプリを開く」リンク先
#   npm start（本番）: http://127.0.0.1:8787   npm run dev（開発）: http://127.0.0.1:5173
APP_URL=http://127.0.0.1:8787

# データ保存先（SQLite・暗号化トークン）。リポジトリルートからの相対パス
DATA_DIR=data

# トークンの保存先: auto | keychain | file
#   auto     … OSの資格情報ストア（macOS キーチェーン / Windows 資格情報マネージャー /
#               Linux Secret Service）を優先し、使えなければ暗号化ファイル
#   keychain … OSの資格情報ストアのみ（使えなければ起動時エラー）
#   file     … AES-256-GCM で暗号化したファイル（data/secrets.enc.json）
SECRET_STORE=auto

# file 方式の暗号鍵（任意）。未指定なら data/secret.key をランダム生成して使用します。
# 指定する場合は十分に長いランダム文字列にしてください。変更すると保存済みトークンは読めなくなります。
TOKEN_ENCRYPTION_KEY=

# 開発用モック。true にすると X API を一切呼ばず、ダミーアカウントで全機能を試せます
X_MOCK=false
